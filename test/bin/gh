#!/usr/bin/env bash
# Test double for `gh api`. It logs each call to $GH_LOG and returns the
# status and body that the test sets for the route:
#   GH_STUB_<ROUTE>_STATUS  HTTP status, default 200
#   GH_STUB_<ROUTE>_BODY    JSON body, default {}
# ROUTE is PERMISSION, PULL, COMMENT or REACTION.
# Like the real gh, a status of 400 or more prints the body to stdout, an
# error line to stderr, and exits 1. On success, --jq filters the body and
# --silent prints nothing.
set -euo pipefail

printf '%s\n' "$*" >> "${GH_LOG:?GH_LOG must be set}"

[ "${1:-}" = api ] || { echo "gh stub: only 'gh api' is supported" >&2; exit 2; }
shift
path=$1
shift

jq_filter=
silent=false
while [ $# -gt 0 ]; do
  case "$1" in
    --jq) jq_filter=$2; shift 2 ;;
    --silent) silent=true; shift ;;
    -f) shift 2 ;;
    *) shift ;;
  esac
done

case "$path" in
  repos/*/collaborators/*/permission) route=PERMISSION ;;
  repos/*/pulls/*) route=PULL ;;
  repos/*/issues/comments/*/reactions) route=REACTION ;;
  repos/*/issues/*/comments) route=COMMENT ;;
  *) echo "gh stub: no route for $path" >&2; exit 2 ;;
esac

status_var="GH_STUB_${route}_STATUS"
body_var="GH_STUB_${route}_BODY"
status=${!status_var:-200}
body=${!body_var:-'{}'}

if [ "$status" -ge 400 ]; then
  printf '%s' "$body"
  echo "gh: stub error (HTTP $status)" >&2
  exit 1
fi

if [ "$silent" = true ]; then
  exit 0
fi
if [ -n "$jq_filter" ]; then
  printf '%s' "$body" | jq -r "$jq_filter"
else
  printf '%s\n' "$body"
fi
